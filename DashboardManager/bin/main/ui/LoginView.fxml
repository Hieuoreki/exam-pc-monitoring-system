<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" alignment="CENTER" prefWidth="300" prefHeight="250"
      xmlns:fx="http://javafx.com/fxml/1"
      
      fx:controller="main.ui.LoginController">
    
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Đăng nhập Admin" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    
    <Label text="Server IP:"/>
    <TextField fx:id="ipField" text="localhost"/> <Label text="Server Port:"/>
    <TextField fx:id="portField" text="9999"/>
    
    <Button fx:id="loginButton" text="Kết nối" onAction="#handleLoginButton"/>
    
    <Label fx:id="statusLabel" textFill="RED"/> </VBox>