<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720" prefWidth="1050" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.ui.DashboardController">
    
    <!-- THANH DANH SÁCH MÁY BÊN TRÁI -->
    <left>
        <VBox spacing="10" style="-fx-background-color: #f4f4f4; -fx-padding: 10;" prefWidth="240">
            <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Máy trạm Phòng thi Online" />
            <ListView fx:id="agentListView" VBox.vgrow="ALWAYS" />
        </VBox>
    </left>
    
    <!-- VÙNG ĐIỀU KHIỂN CHÍNH -->
    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="HỆ THỐNG GIÁM SÁT PHÒNG THI" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label fx:id="selectedAgentLabel" text="Chưa chọn Agent nào" style="-fx-font-size: 14px; -fx-text-fill: #2980b9; -fx-font-weight: bold;"/>
            </HBox>
            
            <!-- HÀNG CÁC NÚT ĐIỀU KHIỂN -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="lockButton" disable="true" onAction="#handleLockButton" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="Khóa màn hình" />
                <Button fx:id="unlockButton" disable="true" onAction="#handleUnlockButton" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" text="Mở khóa" />
                <Button fx:id="getConfigButton" disable="true" onAction="#handleGetConfigButton" text="Lấy Cấu hình" />
                <Button fx:id="getProcessesButton" disable="true" onAction="#handleGetProcessesButton" text="Lấy Tiến trình" />
                <Button fx:id="takeScreenshotButton" disable="true" onAction="#handleTakeScreenshotButton" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" text="Chụp màn hình" />
                <Button fx:id="killProcessButton" disable="true" onAction="#handleKillProcessButton" style="-fx-background-color: #f39c12; -fx-text-fill: white;" text="Tắt tiến trình" />
                <Button fx:id="sendAlertMsgButton" disable="true" onAction="#handleSendAlertMsgButton" text="Gửi nhắc nhở" />
            </HBox>
            
            <!-- KHU VỰC THÔNG TIN TIẾN TRÌNH & ẢNH CHỤP MÀN HÌNH -->
            <SplitPane dividerPositions="0.45" VBox.vgrow="ALWAYS">
                <items>
                    <VBox spacing="5">
                        <Label text="Thông tin Hệ thống / Tiến trình:" style="-fx-font-weight: bold;"/>
                        <TextArea fx:id="configTextArea" editable="false" VBox.vgrow="ALWAYS" style="-fx-font-family: monospace;"/>
                    </VBox>
                    <VBox spacing="5" alignment="TOP_CENTER">
                        <Label text="Màn hình Máy trạm (Live Screenshot):" style="-fx-font-weight: bold;"/>
                        <ImageView fx:id="screenshotView" fitHeight="300" fitWidth="500" pickOnBounds="true" preserveRatio="true"/>
                    </VBox>
                </items>
            </SplitPane>
            
            <!-- KHU VỰC NHẬT KÝ CẢNH BÁO VI PHẠM -->
            <VBox spacing="5">
                <Label style="-fx-font-weight: bold; -fx-text-fill: red; -fx-font-size: 13px;" text="Cảnh báo Vi phạm gian lận thời gian thực:" />
                <ListView fx:id="alertListView" prefHeight="130" />
            </VBox>
        </VBox>
    </center>
    
</BorderPane>